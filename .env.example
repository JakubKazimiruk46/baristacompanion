# Zmienne środowiskowe. Skopiuj do .env.local (ten plik nie trafia do repozytorium) i uzupełnij.
# Te same zmienne ustaw w Vercelu: Project → Settings → Environment Variables
# (Production i Preview). Bez nich aplikacja działa jak dotąd, tylko bez konta.

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://twoj-projekt.supabase.co

# Supabase → Project Settings → API Keys → klucz publiczny („anon” albo „publishable”, sb_publishable_…).
# Ten klucz trafia do przeglądarki z założenia: dane chronią reguły Row Level Security w bazie.
VITE_SUPABASE_ANON_KEY=

# Funkcje AI (odczyt etykiety przez Claude, asystent drinków). Włącz (true) dopiero wtedy, gdy funkcje
# scan-label i drink-assistant są wdrożone, a klucz API Claude jest w sekretach Supabase (docs/backend.md, sekcja 9).
# Bez tego etykietę odczytuje telefon, a asystenta drinków nie ma.
VITE_AI_ENABLED=false

# NIGDY tutaj: klucz service_role / secret. Funkcje serwerowe dostają go od Supabase same
# (SUPABASE_SERVICE_ROLE_KEY), a inne sekrety ustawia się poleceniem:
#   npx supabase secrets set NAZWA=wartość
